{
  "name": "obstat",
  "private": true,
  "version": "0.1.0",
  "description": "No proposal leaves a writer until a separate Critic has checked every claim against the person it names.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "ui": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/ui-bridge/server.ts",
    "ui:build": "npm --prefix ui install && npm --prefix ui run build",
    "proof": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/proof/concurrency-proof.ts",
    "doctor": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/doctor.ts",
    "identities": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/data/report.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.3"
  }
}
